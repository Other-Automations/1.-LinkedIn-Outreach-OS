      "id": "d4e5f6a7-0001-0001-0001-000000000008",
      "name": "Check Account Health via UniPile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        288
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Nu9hpzRBe8A9MtM6",
          "name": "Unipile Sachin 08"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const httpResponse = $input.first().json;\nconst account = $('Filter Accounts to Check').item.json;\nconst statusCode = httpResponse.statusCode || 0;\nconst body = httpResponse.body || httpResponse;\n\nlet newStatus = account.status;\nlet isHealthy = false;\nlet failureReason = '';\n\nif (statusCode >= 200 && statusCode < 300) {\n  const accountStatus = body.status || body.object_status || '';\n  if (accountStatus === 'OK' || accountStatus === 'CONNECTED' || accountStatus === '') {\n    isHealthy = true;\n    if (account.status === 'unhealthy' || account.status === 'reconnect_required') {\n      // Do not auto-restore — requires manual intervention\n      newStatus = account.status;\n    } else {\n      newStatus = 'active';\n    }\n  } else if (accountStatus === 'RECONNECT_REQUIRED' || accountStatus === 'DISCONNECTED') {\n    newStatus = 'reconnect_required';\n    failureReason = `UniPile status: ${accountStatus}`;\n  } else {\n    newStatus = 'unhealthy';\n    failureReason = `UniPile status: ${accountStatus}`;\n  }\n} else if (statusCode === 401 || statusCode === 403) {\n  newStatus = 'reconnect_required';\n  failureReason = `Auth failure: HTTP ${statusCode}`;\n} else {\n  failureReason = `API error: HTTP ${statusCode}`;\n  isHealthy = false;\n}\n\nconst currentConsecutive = parseInt(account.consecutive_failures || '0', 10);\nconst newConsecutive = isHealthy ? 0 : currentConsecutive + 1;\nconst pauseThreshold = account._pauseThreshold;\nconst shouldAutoPause = !isHealthy && newConsecutive >= pauseThreshold;\n\nif (shouldAutoPause && newStatus !== 'reconnect_required') {\n  newStatus = 'unhealthy';\n}\n\nreturn [{\n  json: {\n    ...account,\n    _newStatus: newStatus,\n    _isHealthy: isHealthy,\n    _failureReason: failureReason,\n    _newConsecutive: newConsecutive,\n    _shouldAutoPause: shouldAutoPause,\n    _statusCode: statusCode\n  }\n}];"
      },
