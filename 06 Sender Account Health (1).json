    {
      "parameters": {
        "jsCode": "const triggerData = $('Identify Trigger Source').first().json;\nconst settingsRows = $('Read Settings').all();\nconst settings = {};\nfor (const r of settingsRows) {\n  if (r.json.key) settings[r.json.key] = r.json.value;\n}\nconst retryLimit = parseInt(settings['health_check_retry_limit'] || '2', 10);\nconst pauseThreshold = parseInt(settings['error_consecutive_pause_threshold'] || '5', 10);\n\nlet accounts = $('Read All Accounts').all().map(i => i.json);\n\n// If manual trigger with specific account filter, check only that account\nif (triggerData.filterAccount) {\n  accounts = accounts.filter(a => a.account_name === triggerData.filterAccount);\n}\n\n// Only check accounts that are not permanently inactive/blocked\naccounts = accounts.filter(a => !['inactive', 'blocked'].includes(a.status));\n\nreturn accounts.map(a => ({ json: { ...a, _retryLimit: retryLimit, _pauseThreshold: pauseThreshold, _isManual: triggerData.isManual } }));"
      },
      "id": "d4e5f6a7-0001-0001-0001-000000000007",
