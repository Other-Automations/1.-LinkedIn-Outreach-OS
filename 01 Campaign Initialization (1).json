    {
      "parameters": {
        "jsCode": "const validatedPayload = $('Validate Payload').first().json;\nconst campaignId = $('Generate Campaign ID').first().json.campaign_id;\nconst accountRows = $('Read Active Accounts').all();\nconst prospectsFromSheet = $('Read Prospects Sheet').all();\nconst existingDbRows = $('Read Existing Database Rows').all();\n\nconst selectedNames = validatedPayload.selected_account_names;\nconst accounts = accountRows\n  .map(r => r.json)\n  .filter(a => a.status === 'active' && selectedNames.includes(a.account_name))\n  .sort((a, b) => parseInt(a.connections_sent_today || '0') - parseInt(b.connections_sent_today || '0'));\n\nif (accounts.length === 0) {\n  return [{ json: { valid: false, error: `None of the selected accounts (${selectedNames.join(', ')}) are currently active` } }];\n}\n\nconst existingKeys = new Set(\n  existingDbRows\n    .filter(r => r.json.prospect_id && r.json.campaign_id)\n    .map(r => `${r.json.prospect_id}__${r.json.campaign_id}`)\n);\n\nfunction normalizeLinkedInUrl(raw) {\n  if (!raw || typeof raw !== 'string') return null;\n  let u = raw.trim().toLowerCase();\n  u = u.replace(/[?#].*$/, '');\n  u = u.replace(/\\/+$/, '');\n  if (!u.startsWith('https://')) {\n    u = u.replace(/^http:\\/\\//, '');\n    if (!u.startsWith('www.')) u = 'www.' + u;\n    u = 'https://' + u;\n  }\n  if (u.includes('linkedin.com') && !u.includes('www.linkedin.com')) {\n    u = u.replace('linkedin.com', 'www.linkedin.com');\n  }\n  return u;\n}\n\nfunction isValidLinkedInUrl(url) {\n  if (!url) return false;\n  return /^https:\\/\\/www\\.linkedin\\.com\\/in\\/[a-zA-Z0-9\\-_]+$/.test(url);\n}\n\nconst requestedCount = validatedPayload.prospect_count;\nconst now = new Date().toISOString();\nconst rows = [];\nconst skipped_dup = [];\nconst skipped_invalid = [];\n\nfor (const prospectRow of prospectsFromSheet) {\n  if (rows.length >= requestedCount) break;\n\n  const p = prospectRow.json;\n\n  const prospectId = p.prospect_id || String(p.row_number);\n  if (!prospectId) {\n    skipped_invalid.push('unknown:no_id');\n    continue;\n  }\n\n  const key = `${prospectId}__${campaignId}`;\n  if (existingKeys.has(key)) {\n    skipped_dup.push(prospectId);\n    continue;\n  }\n\n  const linkedinUrl = normalizeLinkedInUrl(p.linkedIn_url || p.linkedin_url);\n  if (!isValidLinkedInUrl(linkedinUrl)) {\n    skipped_invalid.push(prospectId + ':invalid_url');\n    continue;\n  }\n\n  const account = accounts[rows.length % accounts.length];\n  const rowId = `${campaignId}_${prospectId}_${Date.now()}`;\n\n  rows.push({\n    json: {\n      row_id: rowId,\n      prospect_id: prospectId,\n      campaign_id: campaignId,\n      campaign_name: validatedPayload.campaign_name || '',\n      linkedin_url: linkedinUrl,\n      first_name: p.first_name || '',\n      last_name: p.last_name || '',\n      company_name: p.company_name || '',\n      title: p.title || '',\n      city: p.city || '',\n      country: p.country || '',\n      company_website: p.company_website || '',\n      sending_account: account.account_name,\n      provider_id: '',\n      chat_id: '',\n      connection_request_status: '',\n      connection_request_time: '',\n      connection_accepted: 'false',\n      connection_accepted_time: '',\n      message_1_eligible: 'false',\n      message_1_sent: 'false',\n      message_1_time: '',\n      message_2_sent: 'false',\n      message_2_time: '',\n      message_3_sent: 'false',\n      message_3_time: '',\n      reply_received: 'false',\n      reply_text: '',\n      reply_time: '',\n      withdrawal_eligible_at: '',\n      retry_count: '0',\n      failure_reason: '',\n      last_updated: now,\n      lifecycle_state: 'ready_for_invite'\n    }\n  });\n}\n\nif (rows.length === 0) {\n  return [{ json: { valid: false, error: `No eligible prospects found. Duplicates skipped: ${skipped_dup.length}, Invalid/missing URLs: ${skipped_invalid.length}` } }];\n}\n\nconst result = [...rows];\nresult[0].json._meta = {\n  rows_created: rows.length,\n  prospect_count_requested: requestedCount,\n  skipped_dup: skipped_dup.length,\n  skipped_invalid: skipped_invalid.length,\n  campaign_id: campaignId,\n  accounts_used: [...new Set(rows.map(r => r.json.sending_account))]\n};\n\nreturn result;"
      },
