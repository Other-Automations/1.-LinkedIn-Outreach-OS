      "parameters": {
        "jsCode": "// Validate incoming payload from frontend.\n// Frontend sends campaign config + prospect_count + selected accounts.\n// Frontend does NOT send campaign_id, prospect_ids, or prospects[].\n// Expected shape:\n// {\n//   campaign_name: string,\n//   connection_note: string,\n//   message_1: string,\n//   message_2: string (optional),\n//   message_3: string (optional),\n//   message_2_delay_hours: number (default 48),\n//   message_3_delay_hours: number (default 72),\n//   selected_account_names: string[] (non-empty),\n//   prospect_count: number (positive integer)\n// }\nconst body = $input.first().json.body || {};\n\nif (!body.campaign_name) {\n  return [{ json: { valid: false, error: 'Missing campaign_name' } }];\n}\nif (!body.connection_note) {\n  return [{ json: { valid: false, error: 'Missing connection_note' } }];\n}\nif (!body.message_1) {\n  return [{ json: { valid: false, error: 'Missing message_1' } }];\n}\nif (!Array.isArray(body.selected_account_names) || body.selected_account_names.length === 0) {\n  return [{ json: { valid: false, error: 'selected_account_names must be a non-empty array of account names' } }];\n}\nif (!body.prospect_count || typeof body.prospect_count !== 'number' || !Number.isInteger(body.prospect_count) || body.prospect_count < 1) {\n  return [{ json: { valid: false, error: 'prospect_count must be a positive integer (e.g. 50, 100, 500)' } }];\n}\n\nreturn [{ json: {\n  valid: true,\n  campaign_name: body.campaign_name,\n  connection_note: body.connection_note,\n  message_1: body.message_1,\n  message_2: body.message_2 || '',\n  message_3: body.message_3 || '',\n  message_2_delay_hours: typeof body.message_2_delay_hours === 'number' ? body.message_2_delay_hours : 48,\n  message_3_delay_hours: typeof body.message_3_delay_hours === 'number' ? body.message_3_delay_hours : 72,\n  selected_account_names: body.selected_account_names,\n  prospect_count: body.prospect_count\n} }];"
      },
