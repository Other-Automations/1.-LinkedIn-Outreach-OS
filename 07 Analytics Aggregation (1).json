    {
      "parameters": {
        "jsCode": "const dbRows = $('Read Database Sheet').all().map(i => i.json);\nconst campaigns = $('Read Campaigns Sheet').all().map(i => i.json);\nconst accounts = $('Read Accounts Sheet').all().map(i => i.json);\n\nconst now = new Date();\nconst todayStr = now.toISOString().split('T')[0];\n\n// Helper: is date today?\nconst isToday = (ts) => ts && ts.startsWith(todayStr);\n\n// Helper: safe division\nconst pct = (num, den) => den > 0 ? Math.round((num / den) * 10000) / 100 : 0;\n\n// --- Global metrics ---\nconst totalRows = dbRows.length;\nconst invitesSentTotal = dbRows.filter(r => r.connection_request_time).length;\nconst invitesSentToday = dbRows.filter(r => isToday(r.connection_request_time)).length;\nconst invitesAccepted = dbRows.filter(r => r.connection_accepted === 'TRUE' || r.connection_accepted === true).length;\nconst repliesReceived = dbRows.filter(r => r.reply_received === 'TRUE' || r.reply_received === true).length;\nconst msg1Sent = dbRows.filter(r => r.message_1_sent === 'TRUE' || r.message_1_sent === true).length;\nconst msg2Sent = dbRows.filter(r => r.message_2_sent === 'TRUE' || r.message_2_sent === true).length;\nconst msg3Sent = dbRows.filter(r => r.message_3_sent === 'TRUE' || r.message_3_sent === true).length;\nconst withdrawn = dbRows.filter(r => r.lifecycle_state === 'withdrawn').length;\nconst completed = dbRows.filter(r => r.lifecycle_state === 'completed').length;\nconst failed = dbRows.filter(r => r.lifecycle_state === 'failed').length;\nconst pendingInvites = dbRows.filter(r => r.lifecycle_state === 'ready_for_invite').length;\nconst awaitingAcceptance = dbRows.filter(r => r.lifecycle_state === 'invite_sent').length;\n\nconst acceptanceRate = pct(invitesAccepted, invitesSentTotal);\nconst replyRate = pct(repliesReceived, invitesAccepted);\nconst followup1Rate = pct(msg2Sent, msg1Sent);\nconst followup2Rate = pct(msg3Sent, msg2Sent);\n\n// --- Per-campaign metrics ---\nconst campaignMetrics = campaigns.map(c => {\n  const cRows = dbRows.filter(r => r.campaign_id === c.campaign_id);\n  const cSent = cRows.filter(r => r.connection_request_time).length;\n  const cAccepted = cRows.filter(r => r.connection_accepted === 'TRUE' || r.connection_accepted === true).length;\n  const cReplied = cRows.filter(r => r.reply_received === 'TRUE' || r.reply_received === true).length;\n  const cMsg1 = cRows.filter(r => r.message_1_sent === 'TRUE' || r.message_1_sent === true).length;\n  return {\n    campaign_id: c.campaign_id,\n    campaign_name: c.campaign_name,\n    campaign_status: c.campaign_status,\n    total_prospects: cRows.length,\n    invites_sent: cSent,\n    invites_accepted: cAccepted,\n    replies_received: cReplied,\n    messages_sent: cMsg1,\n    acceptance_rate: pct(cAccepted, cSent),\n    reply_rate: pct(cReplied, cAccepted)\n  };\n});\n\n// --- Per-account metrics ---\nconst accountMetrics = accounts.map(a => {\n  const aRows = dbRows.filter(r => r.sending_account === a.account_name);\n  const aSent = aRows.filter(r => r.connection_request_time).length;\n  const aSentToday = aRows.filter(r => isToday(r.connection_request_time)).length;\n  return {\n    account_name: a.account_name,\n    status: a.status,\n    total_invites_sent: aSent,\n    invites_sent_today: aSentToday,\n    connections_sent_today: parseInt(a.connections_sent_today || '0', 10),\n    dms_sent_today: parseInt(a.dms_sent_today || '0', 10),\n    consecutive_failures: parseInt(a.consecutive_failures || '0', 10)\n  };\n});\n\n// --- Lifecycle state distribution ---\nconst lifecycleStates = ['ready_for_invite','invite_sent','invite_accepted','waiting_for_followup','followup_1_sent','followup_2_sent','replied','completed','withdrawn','failed'];\nconst stateDistribution = {};\nfor (const s of lifecycleStates) {\n  stateDistribution[s] = dbRows.filter(r => r.lifecycle_state === s).length;\n}\n\n// --- Daily trend: last 30 days ---\nconst dailyTrend = [];\nfor (let d = 29; d >= 0; d--) {\n  const day = new Date(now);\n  day.setDate(day.getDate() - d);\n  const dayStr = day.toISOString().split('T')[0];\n  const dayInvites = dbRows.filter(r => r.connection_request_time && r.connection_request_time.startsWith(dayStr)).length;\n  const dayAccepted = dbRows.filter(r => r.connection_accepted_time && r.connection_accepted_time.startsWith(dayStr)).length;\n  const dayReplies = dbRows.filter(r => r.reply_time && r.reply_time.startsWith(dayStr)).length;\n  dailyTrend.push({ date: dayStr, invites: dayInvites, accepted: dayAccepted, replies: dayReplies });\n}\n\n// --- Active counts ---\nconst activeAccounts = accounts.filter(a => a.status === 'active').length;\nconst unhealthyAccounts = accounts.filter(a => ['unhealthy','reconnect_required'].includes(a.status)).length;\nconst activeCampaigns = campaigns.filter(c => c.campaign_status === 'running').length;\n\n// Build summary row for Analytics Sheet\nconst summary = {\n  last_updated: now.toISOString(),\n  total_prospects_in_db: totalRows,\n  invites_sent_total: invitesSentTotal,\n  invites_sent_today: invitesSentToday,\n  invites_accepted_total: invitesAccepted,\n  replies_received_total: repliesReceived,\n  message_1_sent_total: msg1Sent,\n  message_2_sent_total: msg2Sent,\n  message_3_sent_total: msg3Sent,\n  withdrawn_total: withdrawn,\n  completed_total: completed,\n  failed_total: failed,\n  pending_invites: pendingInvites,\n  awaiting_acceptance: awaitingAcceptance,\n  acceptance_rate_pct: acceptanceRate,\n  reply_rate_pct: replyRate,\n  followup1_send_rate_pct: followup1Rate,\n  followup2_send_rate_pct: followup2Rate,\n  active_campaigns: activeCampaigns,\n  active_accounts: activeAccounts,\n  unhealthy_accounts: unhealthyAccounts,\n  lifecycle_distribution: JSON.stringify(stateDistribution),\n  per_campaign_metrics: JSON.stringify(campaignMetrics),\n  per_account_metrics: JSON.stringify(accountMetrics),\n  daily_trend_30d: JSON.stringify(dailyTrend)\n};\n\nreturn [{ json: summary }];"
      },
