    {
      "parameters": {
        "jsCode": "// Build a single error log row from the incoming data\n// Expected input fields: severity, workflow_name, row_id, account_name, description, raw_error\nconst input = $input.first().json;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    severity: input.severity || 'error',\n    workflow_name: input.workflow_name || 'unknown',\n    row_id: input.row_id || '',\n    account_name: input.account_name || '',\n    description: input.description || '',\n    raw_error: typeof input.raw_error === 'object'\n      ? JSON.stringify(input.raw_error)\n      : (input.raw_error || '')\n  }\n}];"
      },
