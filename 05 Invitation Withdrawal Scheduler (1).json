    {
      "parameters": {
        "jsCode": "const eligibleRows = $('Filter Withdrawal Eligible').all().map(i => i.json);\nconst accountRows = $('Read Accounts for Withdrawal').all().map(i => i.json);\nconst accountMap = {};\nfor (const a of accountRows) {\n  if (a.account_name) accountMap[a.account_name] = a;\n}\n\nreturn eligibleRows.map(row => {\n  const account = accountMap[row.sending_account] || {};\n  return { json: { ...row, _unipile_id: account.unipile_id || '', _unipile_dsn: account.unipile_dsn || $vars.UNIPILE_DSN } };\n});"
      },
