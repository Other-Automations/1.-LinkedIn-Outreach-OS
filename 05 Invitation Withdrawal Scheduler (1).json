    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst settings = {};\nfor (const row of rows) {\n  if (row.json.key) settings[row.json.key] = row.json.value;\n}\nconst locked = settings['withdrawal_scheduler_locked'] === 'true';\nconst lockTime = settings['withdrawal_scheduler_lock_time'] || '';\nconst staleMinutes = parseInt(settings['scheduler_stale_lock_minutes'] || '10', 10);\nlet isStale = false;\nif (locked && lockTime) {\n  const lockAge = (Date.now() - new Date(lockTime).getTime()) / 60000;\n  isStale = lockAge > staleMinutes;\n}\nreturn [{ json: { settings, locked, isStale } }];"
      },
