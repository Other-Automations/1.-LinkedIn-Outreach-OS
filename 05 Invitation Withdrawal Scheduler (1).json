      "parameters": {
        "jsCode": "const settings = $('Build Settings and Check Lock').first().json.settings;\nconst withdrawalDays = parseFloat(settings['invitation_withdrawal_days'] || '7');\nconst now = new Date();\n\nconst eligible = $input.all().filter(item => {\n  const row = item.json;\n  if (!row.withdrawal_eligible_at) return false;\n  const eligibleAt = new Date(row.withdrawal_eligible_at);\n  return now >= eligibleAt;\n});\n\nreturn eligible;"
      },
